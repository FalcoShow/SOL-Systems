# ============================================================
#  SOL SYSTEMS — Environment Variable Template
#  Copy this file to .env and fill in all values
#  NEVER commit your real .env file to git
#  NEVER share your private key with anyone
# ============================================================


# ────────────────────────────────────────────────────────────
#  SOLANA RPC CONFIGURATION
#  Sign up at https://helius.dev (free tier works to start)
#  You need BOTH the HTTPS url and the WebSocket (wss://) url
# ────────────────────────────────────────────────────────────

# Your Helius HTTPS RPC endpoint (for queries + sending transactions)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# Your Helius WebSocket endpoint (for real-time wallet monitoring)
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# Helius API key (without the URL — used for direct API calls)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE


# ────────────────────────────────────────────────────────────
#  YOUR TRADING WALLET
#  This is the wallet the bot will USE to execute copy trades
#  NEVER use your main personal wallet — create a dedicated one
#  Fund it with only the capital you want to trade with
#  Private key in base58 format (exported from Phantom/Solflare)
# ────────────────────────────────────────────────────────────

# Your wallet's public key (safe to share — this is just the address)
MY_WALLET_PUBLIC_KEY=YOUR_WALLET_PUBLIC_KEY_HERE

# Your wallet's private key (KEEP THIS SECRET — never share or commit)
# Export from Phantom: Settings > Security & Privacy > Export Private Key
MY_WALLET_PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY_IN_BASE58_HERE


# ────────────────────────────────────────────────────────────
#  JUPITER DEX CONFIGURATION
#  Jupiter is the DEX aggregator used to execute swaps on Solana
#  No API key required — these are free public endpoints
# ────────────────────────────────────────────────────────────

# Jupiter Quote API (gets best swap route and price)
JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6/quote

# Jupiter Swap API (builds the actual swap transaction)
JUPITER_SWAP_API_URL=https://quote-api.jup.ag/v6/swap

# Default slippage in basis points (50 = 0.5%, 100 = 1%, 300 = 3%)
# Higher slippage = more likely to fill, but worse price
# Recommended: 50-100 for most trades, up to 300 for low-liquidity tokens
JUPITER_SLIPPAGE_BPS=100

# Maximum acceptable price impact percentage before refusing to trade
# If a trade would move the price more than this %, skip it (low liquidity)
MAX_PRICE_IMPACT_PCT=5


# ────────────────────────────────────────────────────────────
#  TELEGRAM BOT CONFIGURATION
#  1. Open Telegram, search @BotFather
#  2. Send /newbot, follow prompts, copy the token it gives you
#  3. To get your Chat ID: search @userinfobot and send /start
# ────────────────────────────────────────────────────────────

# Bot token from @BotFather (format: 1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your personal Telegram Chat ID (bot will only respond to this ID)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE


# ────────────────────────────────────────────────────────────
#  DATABASE CONFIGURATION
#  PostgreSQL connection string
#  Local dev:  postgresql://postgres:password@localhost:5432/sol_systems
#  Railway:    Automatically injected as DATABASE_URL when you add the addon
# ────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sol_systems


# ────────────────────────────────────────────────────────────
#  TRADING CAPITAL AND RISK SETTINGS
#  These are your defaults — they can also be changed at runtime
#  via the dashboard or Telegram /capital command
# ────────────────────────────────────────────────────────────

# Your total starting capital in SOL (e.g., 10.5 for 10.5 SOL)
MY_STARTING_CAPITAL_SOL=10.0

# Maximum percentage of your capital per single trade (0.0 to 1.0)
# Example: 0.10 means never use more than 10% of capital on one trade
MAX_POSITION_PCT=0.10

# Minimum SOL to always keep in wallet for gas fees — never trade below this
MIN_SOL_RESERVE=0.1

# Maximum number of open positions allowed at the same time
# New copy trades are skipped if this limit is hit
MAX_OPEN_POSITIONS=10

# Daily loss limit in SOL — bot auto-pauses and alerts you if hit
# Set to 0 to disable
DAILY_LOSS_LIMIT_SOL=2.0

# Transaction confirmation speed
# "confirmed" = ~0.4s faster, recommended for copy trading
# "finalized" = ~1.5s slower, 100% final
COMMITMENT_LEVEL=confirmed


# ────────────────────────────────────────────────────────────
#  PRICE DATA — optional, used for USD display on dashboard
#  Sign up free at https://birdeye.so/developer
# ────────────────────────────────────────────────────────────

BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY_HERE


# ────────────────────────────────────────────────────────────
#  APPLICATION SERVER
# ────────────────────────────────────────────────────────────

# Port the Express API server listens on
PORT=3000

# Environment: "development" or "production"
NODE_ENV=development

# Secret key to authenticate dashboard API requests
# Generate one by running this in your terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=GENERATE_A_STRONG_RANDOM_SECRET_HERE

# URL where your React frontend runs (used for CORS)
DASHBOARD_URL=http://localhost:5173


# ────────────────────────────────────────────────────────────
#  LOGGING
# ────────────────────────────────────────────────────────────

# Log level: "error", "warn", "info", "debug"
# Use "debug" during development, "info" in production
LOG_LEVEL=info

# Days to keep log files before deleting old ones
LOG_RETENTION_DAYS=7