{
    "name":  "sol-systems",
    "version":  "1.0.0",
    "description":  "Solana wallet copy trading system — real-time trade mirroring with Telegram notifications and React dashboard",
    "main":  "src/index.js",
    "author":  "Andrew",
    "license":  "UNLICENSED",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=20.0.0",
                    "npm":  "\u003e=10.0.0"
                },
    "scripts":  {
                    "start":  "npx prisma migrate deploy \u0026\u0026 node src/index.js",
                    "dev":  "nodemon src/index.js",
                    "build":  "npm install",
                    "migrate":  "npx prisma migrate deploy --skip-generate",
                    "migrate:dev":  "npx prisma migrate dev",
                    "migrate:reset":  "npx prisma migrate reset",
                    "prisma:generate":  "npx prisma generate",
                    "prisma:studio":  "npx prisma studio",
                    "seed":  "node scripts/seed.js",
                    "backfill":  "node scripts/backfill.js",
                    "test":  "jest --runInBand",
                    "test:watch":  "jest --watch",
                    "test:coverage":  "jest --coverage",
                    "test:verbose":  "jest --runInBand --verbose",
                    "lint":  "eslint src/**/*.js",
                    "health":  "curl -s http://localhost:3001/health | json_pp"
                },
    "dependencies":  {
                         "@jup-ag/api":  "^6.0.0",
                         "@prisma/client":  "^5.10.0",
                         "@solana/spl-token":  "^0.4.6",
                         "@solana/web3.js":  "^1.90.0",
                         "axios":  "^1.6.7",
                         "bignumber.js":  "^9.1.2",
                         "bs58":  "^5.0.0",
                         "cors":  "^2.8.6",
                         "dayjs":  "^1.11.10",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.18.3",
                         "express-rate-limit":  "^7.2.0",
                         "helmet":  "^7.2.0",
                         "morgan":  "^1.10.1",
                         "node-cron":  "^3.0.3",
                         "p-queue":  "^6.6.2",
                         "p-retry":  "^6.2.0",
                         "telegraf":  "^4.16.3",
                         "uuid":  "^9.0.1",
                         "winston":  "^3.12.0",
                         "winston-daily-rotate-file":  "^5.0.0",
                         "ws":  "^8.19.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.11.0",
                            "@vitejs/plugin-react":  "^5.1.4",
                            "eslint":  "^8.57.0",
                            "jest":  "^29.7.0",
                            "nodemon":  "^3.1.0",
                            "prisma":  "^5.10.0"
                        },
    "jest":  {
                 "testEnvironment":  "node",
                 "testTimeout":  10000,
                 "testMatch":  [
                                   "**/tests/**/*.test.js"
                               ],
                 "silent":  true,
                 "coverageDirectory":  "coverage",
                 "collectCoverageFrom":  [
                                             "src/**/*.js",
                                             "!src/pages/**"
                                         ],
                 "coverageThreshold":  {
                                           "global":  {
                                                          "branches":  60,
                                                          "functions":  70,
                                                          "lines":  70,
                                                          "statements":  70
                                                      }
                                       },
                 "coverageReporters":  [
                                           "text",
                                           "lcov",
                                           "html"
                                       ]
             },
    "nodemonConfig":  {
                          "watch":  [
                                        "src"
                                    ],
                          "ext":  "js,json",
                          "ignore":  [
                                         "src/frontend",
                                         "tests",
                                         "logs"
                                     ],
                          "delay":  1000
                      },
    "_buildTime":  "2026-03-01T22:55:38"
}
