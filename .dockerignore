# ============================================================
#  SOL SYSTEMS — Docker Ignore
#  File: .dockerignore
# ============================================================

# ── Secrets — NEVER copy into image ──────────────────────────
.env
.env.*
!.env.example

# ── Dependencies — reinstalled inside container ───────────────
node_modules/
dashboard/node_modules/

# ── Dashboard — not needed in the bot container ───────────────
dashboard/

# ── Git ───────────────────────────────────────────────────────
.git/
.gitignore

# ── Logs — runtime generated, not build artifacts ─────────────
logs/
*.log

# ── Dev / test files ──────────────────────────────────────────
debug.js
*.test.js
*.spec.js
__tests__/
coverage/

# ── OS / editor junk ──────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo

# ── Docker itself ─────────────────────────────────────────────
Dockerfile
docker-compose.yml
.dockerignore

# NOTE: prisma/migrations/ is intentionally NOT excluded.
# The migration SQL files must be present in the container
# for `prisma migrate deploy` to run on startup.